ing duplicates).\n */\nasync function collectAllPages(fetchPage, { limit = 50 } = {}) {\n  const all = [];\n  let cursor = null;\n  let pages = 0;\n\n  do {\n    const { items, nextCursor } = await fetchPage(cursor);\n    all.push(...(items || []));\n    cursor = nextCursor || null;\n    pages += 1;\n    if (pages >= limit) {\n      console.warn(`Pagination stopped after ${limit} pages as a safety guard; results may be truncated.`);\n      break;\n    }\n  } while (cursor);\n\n  return all;\n}\n\n/**\n * 2. Proactive User Account Permissions Verification Check\n */\nexport async function verifyAccountAccess(sourceId, targetId) {\n  const query = `\n    query {\n      actor {\n        accounts {\n          id\n        }\n      }\n    }\n  `;\n  const response = await runGraphQL(query);\n  const authorizedAccounts = response?.actor?.accounts || [];\n  const authorizedIds = authorizedAccounts.map(acc => acc.id.toString());\n\n  const hasSourceAccess = authorizedIds.includes(sourceId.toString());\n  const hasTargetAccess = authorizedIds.includes(targetId.toString());\n\n  if (!hasSourceAccess) {\n    throw new Error(`Access Denied: You do not have permissions for the Source Account ID (${sourceId}).`);\n  }\n  if (!hasTargetAccess) {\n    throw new Error(`Access Denied: You do not have permissions for the Target Account ID (${targetId}).`);\n  }\n\n  return true;\n}\n\n/*************************************************************\n * DASHBOARDS MIGRATION MODULE (PHASE 1) - UNTOUCHED\n *************************************************************/\n\nexport async function discoverDashboards(accountId, criteria) {\n  const queryStr = `type = 'DASHBOARD' AND accountId = ${accountId}`;\n  \n  const query = `\n    query DiscoverDashboards($queryStr: String!) {\n      actor {\n        entitySearch(query: $queryStr) {\n          results {\n            entities {\n              __typename\n              guid\n              name\n              accountId\n              tags {\n                key\n                values\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n  \n  const data = await runGraphQL(query, { queryStr });\n  let entities = data?.actor?.entitySearch?.results?.entities || [];\n  \n  entities = entities.filter(e => {\n    const typeName = (e.__typename || '').toLowerCase();\n    return !typeName.includes('page');\n  });\n  \n  if (criteria.type === 'KEYWORD' && criteria.keyword) {\n    const kw = criteria.keyword.trim().toLowerCase();\n    entities = entities.filter(e => e.name.toLowerCase().includes(kw));\n  }\n  \n  if (criteria.type === 'TAG' && criteria.tagKey && criteria.tagValue) {\n    const targetKey = criteria.tagKey.trim().toLowerCase();\n    const targetVal = criteria.tagValue.trim().toLowerCase();\n    \n    entities = entities.filter(entity => {\n      return (entity.tags || []).some(tag => {\n        const isKeyMatch = tag.key.toLowerCase() === targetKey;\n        const hasValueMatch = (tag.values || []).some(val => val.toLowerCase() === targetVal);\n        return isKeyMatch && hasValueMatch;\n      });\n    });\n  }\n\n  const groupedParents = {};\n  \n  entities.forEach(item => {\n    const name = (item.name || '').trim();\n    let parentName = name;\n    let pageName = 'Overview';\n    \n    if (name.includes(' / ')) {\n      const parts = name.split(' / ');\n      parentName = parts[0].trim();\n      pageName = parts.slice(1).join(' / ').trim();\n    }\n    \n    if (!groupedParents[parentName]) {\n      groupedParents[parentName] = {\n        name: parentName,\n        guid: parentName === name ? item.guid : null,\n        accountId: item.accountId,\n        pagesToMigrate: []\n      };\n    }\n    \n    groupedParents[parentName].pagesToMigrate.push({\n      pageName: pageName,\n      guid: item.guid\n    });\n    \n    if (parentName === name) {\n      groupedParents[parentName].guid = item.guid;\n    }\n  });\n\n  return Object.values(groupedParents).map(p => {\n    if (!p.guid && p.pagesToMigrate.length > 0) {\n      p.guid = p.pagesToMigrate[0].guid;\n    }\n    return p;\n  });\n}\n\nexport async function fetchSourceDashboard(guid) {\n  const query = `\n    query GetSourceDashboard($guid: EntityGuid!) {\n      actor {\n        entity(guid: $guid) {\n          ... on DashboardEntity {\n            name\n            permissions\n            pages {\n              name\n              widgets {\n                visualization { id }\n                title\n                layout { row width height column }\n                rawConfiguration\n              }\n            }\n            variables {\n              name\n              title\n              type\n              isMultiSelection\n              replacementStrategy\n              defaultValues {\n                value {\n                  string\n                }\n              }\n              items {\n                title\n                value\n              }\n              nrqlQuery {\n                accountIds\n                query\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n  const data = await runGraphQL(query, { guid });\n  return data?.actor?.entity;\n}\n\nexport async function createTargetDashboard(accountId, dashboardInput) {\n  const mutation = `\n    mutation CreateTargetDashboard($accountId: Int!, $dashboard: DashboardInput!) {\n      dashboardCreate(accountId: $accountId, dashboard: $dashboard) {\n        entityResult {\n          guid\n          name\n        }\n        errors {\n          description\n        }\n      }\n    }\n  `;\n  const variables = {\n    accountId: parseInt(accountId),\n    dashboard: dashboardInput\n  };\n\n  const response = await NerdGraphMutation.mutate({ mutation, variables });\n  \n  if (response.error) {\n    throw new Error(response.error.message || \"GraphQL Mutation Error\");\n  }\n\n  if (response.errors && response.errors.length > 0) {\n    throw new Error(response.errors.map(e => e.message).join(', '));\n  }\n  \n  const data = response.data;\n  const errors = data?.dashboardCreate?.errors;\n  if (errors && errors.length > 0) {\n    throw new Error(errors.map(e => e.description).join(', '));\n  }\n  \n  return data?.dashboardCreate?.entityResult;\n}\n\nfunction cleanAccountIdsRecursively(obj, srcAccId, tgtAccId) {\n  if (!obj || typeof obj !== 'object') {\n    return obj;\n  }\n\n  if (Array.isArray(obj)) {\n    return obj.map(item => cleanAccountIdsRecursively(item, srcAccId, tgtAccId));\n  }\n\n  const cleanObj = {};\n  for (const [key, value] of Object.entries(obj)) {\n    if (key === 'accountIds' && Array.isArray(value)) {\n      let updatedIds = value\n        .map(id => parseInt(id))\n        .filter(id => id !== srcAccId);\n      \n      if (!updatedIds.includes(tgtAccId)) {\n        updatedIds.push(tgtAccId);\n      }\n      \n      cleanObj[key] = updatedIds;\n    } else if (key === 'accountId') {\n      const parsedId = parseInt(value);\n      if (parsedId === srcAccId) {\n        cleanObj[key] = tgtAccId;\n      } else {\n        cleanObj[key] = value;\n      }\n    } else {\n      cleanObj[key] = cleanAccountIdsRecursively(value, srcAccId, tgtAccId);\n    }\n  }\n  return cleanObj;\n}\n\nexport function mapVariables(variablesList, sourceAccountId, targetAccountId) {\n  const srcAccId = parseInt(sourceAccountId);\n  const tgtAccId = parseInt(targetAccountId);\n\n  return (variablesList || []).map(variable => {\n    const cleanVar = {\n      name: variable.name,\n      title: variable.title || \"\",\n      type: variable.type || \"TEXT\",\n      isMultiSelection: !!variable.isMultiSelection,\n      replacementStrategy: variable.replacementStrategy || \"STRING\",\n    };\n\n    if (variable.defaultValues) {\n      cleanVar.defaultValues = variable.defaultValues.map(item => ({\n        value: {\n          string: item.value?.string || \"\"\n        }\n      }));\n    }\n\n    if (variable.items) {\n      cleanVar.items = variable.items.map(item => ({\n        title: item.title || \"\",\n        value: item.value || \"\"\n      }));\n    }\n\n    if (variable.nrqlQuery) {\n      let cleanAccountIds = [tgtAccId];\n      if (variable.nrqlQuery.accountIds && variable.nrqlQuery.accountIds.length > 0) {\n        cleanAccountIds = variable.nrqlQuery.accountIds\n          .map(id => parseInt(id))\n          .filter(id => id !== srcAccId);\n        if (!cleanAccountIds.includes(tgtAccId)) {\n          cleanAccountIds.push(tgtAccId);\n        }\n      }\n      \n      cleanVar.nrqlQuery = {\n        accountIds: cleanAccountIds,\n        query: variable.nrqlQuery.query || \"\"\n      };\n    }\n\n    return cleanVar;\n  });\n}\n\nexport function mapPageToDashboardPageInput(page, sourceAccountId, targetAccountId) {\n  if (!page) return null;\n\n  const srcAccId = parseInt(sourceAccountId);\n  const tgtAccId = parseInt(targetAccountId);\n\n  return {\n    name: page.name,\n    widgets: (page.widgets || []).map(widget => {\n      const cleanRawConfig = cleanAccountIdsRecursively(widget.rawConfiguration || {}, srcAccId, tgtAccId);\n\n      const cleanWidget = {\n        title: widget.title || \"\",\n        rawConfiguration: cleanRawConfig\n      };\n      \n      if (widget.visualization?.id) {\n        cleanWidget.visualization = { id: widget.visualization.id };\n      }\n\n      if (widget.layout) {\n        cleanWidget.layout = {\n          row: parseInt(widget.layout.row) || 1,\n          column: parseInt(widget.layout.column) || 1,\n          height: parseInt(widget.layout.height) || 1,\n          width: parseInt(widget.layout.width) || 1\n        };\n      }\n\n      return cleanWidget;\n    })\n  };\n}\n\nexport function mapEntityToDashboardInput(entity, sourceAccountId, targetAccountId) {\n  if (!entity) return null;\n\n  return {\n    name: entity.name, \n    permissions: entity.permissions || \"PUBLIC_READ_WRITE\",\n    pages: (entity.pages || []).map(page => mapPageToDashboardPageInput(page, sourceAccountId, targetAccountId)),\n    variables: mapVariables(entity.variables, sourceAccountId, targetAccountId)\n  };\n}\n\n/*************************************************************\n * ALERTS MIGRATION MODULE (PHASE 2)\n *\n * Design notes / why this differs from the previous version:\n *\n * - policyId is `ID` in the NerdGraph Alerts schema, not `String`. Declaring the\n *   variable as `String!` makes GraphQL reject the document at validation time, so\n *   *every* condition read and write failed before it reached the resolver.\n * - `valueFunction` no longer exists on the static-condition input; sending it is a\n *   hard validation error.\n * - `signal.aggregationDelay` and `signal.aggregationTimer` are mutually exclusive and\n *   tied to `aggregationMethod`. Unconditionally sending a delay breaks any source\n *   condition that uses EVENT_TIMER.\n * - Baseline conditions cannot be created with the static mutation. They are now routed\n *   to `alertsNrqlConditionBaselineCreate`.\n * - Notification destinations hold credentials that NerdGraph will never return\n *   (auth tokens, webhook secrets). Those types cannot be recreated programmatically,\n *   so they are reported as \"needs manual setup\" instead of being silently faked.\n *************************************************************/\n\n/** Destination types whose full configuration is readable, so we can safely recreate them. */\nconst RECREATABLE_DESTINATION_TYPES = new Set(['EMAIL', 'MOBILE_PUSH']);\n\n/**\n * Destination types that carry secrets NerdGraph will not return (auth blocks, tokens,\n * webhook URLs with embedded keys). These must be created by hand in the target account.\n */\nexport function canRecreateDestinationType(type) {\n  return RECREATABLE_DESTINATION_TYPES.has((type || '').toUpperCase());\n}\n\n/*************************************************************\n * POLICIES\n *************************************************************/\n\n/**\n * Discovers alert policies from the source account (all pages).\n */\nexport async function discoverAlertPolicies(accountId, criteria) {\n  if (criteria && criteria.type === 'TAG') {\n    throw new Error(\"New Relic Alert Policies do not natively support tagging schemas. Please use 'Migrate All' or 'Filter by Keyword' to discover policies.\");\n  }\n\n  const query = `\n    query GetPolicies($accountId: Int!, $cursor: String) {\n      actor {\n        account(id: $accountId) {\n          alerts {\n            policiesSearch(cursor: $cursor) {\n              nextCursor\n              policies {\n                id\n                name\n                incidentPreference\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  let policies = await collectAllPages(async (cursor) => {\n    const data = await runGraphQL(query, { accountId: parseInt(accountId), cursor });\n    const page = data?.actor?.account?.alerts?.policiesSearch;\n    return { items: page?.policies || [], nextCursor: page?.nextCursor };\n  });\n\n  if (criteria && criteria.type === 'KEYWORD' && criteria.keyword) {\n    const kw = criteria.keyword.trim().toLowerCase();\n    policies = policies.filter(p => (p.name || '').toLowerCase().includes(kw));\n  }\n\n  return policies;\n}\n\n/**\n * Fetch the condition list for a policy (all pages).\n * `__typename` is selected so the migration can tell static from baseline conditions.\n */\nexport async function fetchPolicyConditionsList(accountId, policyId) {\n  const query = `\n    query GetConditionsList($accountId: Int!, $policyId: ID!, $cursor: String) {\n      actor {\n        account(id: $accountId) {\n          alerts {\n            nrqlConditionsSearch(searchCriteria: { policyId: $policyId }, cursor: $cursor) {\n              nextCursor\n              nrqlConditions {\n                __typename\n                id\n                name\n                enabled\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  return collectAllPages(async (cursor) => {\n    const data = await runGraphQL(query, {\n      accountId: parseInt(accountId),\n      policyId: String(policyId),\n      cursor\n    });\n    const page = data?.actor?.account?.alerts?.nrqlConditionsSearch;\n    return { items: page?.nrqlConditions || [], nextCursor: page?.nextCursor };\n  });\n}\n\n/**\n * Detailed condition fetcher.\n *\n * Tier 1 asks for everything we can copy. Tier 2 drops the fields most likely to be\n * missing on an older schema and records what had to be defaulted, so a partial copy\n * is still reported honestly instead of looking like a clean success.\n */\nexport async function fetchSingleConditionDetails(accountId, conditionId) {\n  const accountIdInt = parseInt(accountId);\n\n  const fullQuery = `\n    query GetFullCondition($accountId: Int!, $id: ID!) {\n      actor {\n        account(id: $accountId) {\n          alerts {\n            nrqlCondition(id: $id) {\n              __typename\n              id\n              name\n              enabled\n              description\n              runbookUrl\n              violationTimeLimitSeconds\n              nrql {\n                query\n              }\n              signal {\n                aggregationWindow\n                aggregationMethod\n                aggregationDelay\n                aggregationTimer\n                evaluationDelay\n                fillOption\n                fillValue\n                slideBy\n              }\n              terms {\n                threshold\n                thresholdOccurrences\n                thresholdDuration\n                operator\n                priority\n              }\n              expiration {\n                closeViolationsOnExpiration\n                expirationDuration\n                openViolationOnExpiration\n              }\n              ... on AlertsNrqlBaselineCondition {\n                baselineDirection\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  const coreQuery = `\n    query GetCoreCondition($accountId: Int!, $id: ID!) {\n      actor {\n        account(id: $accountId) {\n          alerts {\n            nrqlCondition(id: $id) {\n              __typename\n              id\n              name\n              enabled\n              description\n              nrql {\n                query\n              }\n              terms {\n                threshold\n                thresholdOccurrences\n                thresholdDuration\n                operator\n                priority\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  try {\n    const data = await runGraphQL(\n      fullQuery,\n      { accountId: accountIdInt, id: String(conditionId) },\n      { tolerateFieldErrors: true }\n    );\n    const cond = data?.actor?.account?.alerts?.nrqlCondition;\n    if (cond) {\n      return { ...cond, migrationNotes: [] };\n    }\n    throw new Error('Detailed condition query returned no condition.');\n  } catch (e) {\n    console.warn(\n      `Detailed condition query failed for condition ${conditionId}: ${e.message}. Retrying with the core field set.`\n    );\n\n    const fallbackData = await runGraphQL(coreQuery, { accountId: accountIdInt, id: String(conditionId) });\n    const rawCond = fallbackData?.actor?.account?.alerts?.nrqlCondition;\n    if (!rawCond) {\n      throw new Error(`Condition ${conditionId} not found or inaccessible in the source account. (${e.message})`);\n    }\n\n    return {\n      ...rawCond,\n      violationTimeLimitSeconds: 86400,\n      signal: {\n        aggregationWindow: 60,\n        aggregationMethod: 'EVENT_FLOW',\n        aggregationDelay: 120\n      },\n      migrationNotes: [\n        'Advanced settings (signal timing, expiration, runbook URL) could not be read from the source and were set to New Relic defaults.'\n      ]\n    };\n  }\n}\n\n/**\n * IDEMPOTENT: Creates or reuses a target Alert Policy by matching its name.\n */\nexport async function createTargetAlertPolicy(accountId, name, incidentPreference) {\n  const checkQuery = `\n    query FindPolicy($accountId: Int!, $cursor: String) {\n      actor {\n        account(id: $accountId) {\n          alerts {\n            policiesSearch(cursor: $cursor) {\n              nextCursor\n              policies {\n                id\n                name\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  const existingPolicies = await collectAllPages(async (cursor) => {\n    const data = await runGraphQL(checkQuery, { accountId: parseInt(accountId), cursor });\n    const page = data?.actor?.account?.alerts?.policiesSearch;\n    return { items: page?.policies || [], nextCursor: page?.nextCursor };\n  });\n\n  const wanted = (name || '').trim().toLowerCase();\n  const match = existingPolicies.find(p => (p.name || '').trim().toLowerCase() === wanted);\n  if (match) {\n    return { id: match.id, name: match.name, skipped: true };\n  }\n\n  const mutation = `\n    mutation CreatePolicy($accountId: Int!, $policy: AlertsPolicyInput!) {\n      alertsPolicyCreate(accountId: $accountId, policy: $policy) {\n        id\n        name\n      }\n    }\n  `;\n\n  const data = await runMutation(mutation, {\n    accountId: parseInt(accountId),\n    policy: {\n      name,\n      // incidentPreference is non-null in the schema; a null from the source would\n      // otherwise fail validation with an unhelpful message.\n      incidentPreference: incidentPreference || 'PER_POLICY'\n    }\n  });\n\n  const created = data?.alertsPolicyCreate;\n  if (!created?.id) {\n    throw new Error(`Policy \"${name}\" could not be created (no policy returned).`);\n  }\n  return created;\n}\n\n/*************************************************************\n * CONDITIONS\n *************************************************************/\n\n/**\n * Existing condition names under a target policy, fetched once per policy rather than\n * once per condition. Returns a lowercased Set for the duplicate check.\n */\nexport async function fetchExistingConditionNames(accountId, policyId) {\n  const conditions = await fetchPolicyConditionsList(accountId, policyId);\n  return new Set(conditions.map(c => (c.name || '').trim().toLowerCase()));\n}\n\n/**\n * `aggregationDelay` is only valid for CADENCE / EVENT_FLOW, and `aggregationTimer`\n * only for EVENT_TIMER. Sending the wrong one is rejected by the API.\n */\nfunction buildSignalInput(signal) {\n  if (!signal) return undefined;\n\n  const method = signal.aggregationMethod || 'EVENT_FLOW';\n  const out = { aggregationMethod: method };\n\n  if (signal.aggregationWindow != null) {\n    out.aggregationWindow = parseInt(signal.aggregationWindow, 10);\n  }\n\n  if (method === 'EVENT_TIMER') {\n    out.aggregationTimer = signal.aggregationTimer != null ? parseInt(signal.aggregationTimer, 10) : 60;\n  } else {\n    out.aggregationDelay = signal.aggregationDelay != null ? parseInt(signal.aggregationDelay, 10) : 120;\n  }\n\n  if (signal.evaluationDelay != null) out.evaluationDelay = parseInt(signal.evaluationDelay, 10);\n  if (signal.slideBy != null) out.slideBy = parseInt(signal.slideBy, 10);\n\n  if (signal.fillOption) {\n    out.fillOption = signal.fillOption;\n    // fillValue is only meaningful (and only accepted) with the STATIC fill option.\n    if (signal.fillOption === 'STATIC') {\n      out.fillValue = signal.fillValue != null ? parseFloat(signal.fillValue) : 0;\n    }\n  }\n\n  return out;\n}\n\nfunction buildExpirationInput(expiration) {\n  if (!expiration) return undefined;\n\n  const out = {};\n  if (expiration.closeViolationsOnExpiration != null) {\n    out.closeViolationsOnExpiration = !!expiration.closeViolationsOnExpiration;\n  }\n  if (expiration.openViolationOnExpiration != null) {\n    out.openViolationOnExpiration = !!expiration.openViolationOnExpiration;\n  }\n  if (expiration.expirationDuration != null) {\n    out.expirationDuration = parseInt(expiration.expirationDuration, 10);\n  }\n\n  return Object.keys(out).length > 0 ? out : undefined;\n}\n\nfunction buildTermsInput(terms, { baseline = false } = {}) {\n  const cleaned = (terms || []).map(t => {\n    const term = {\n      threshold: parseFloat(t.threshold),\n      thresholdOccurrences: t.thresholdOccurrences || 'ALL',\n      thresholdDuration: parseInt(t.thresholdDuration, 10) || 300,\n      priority: t.priority || 'CRITICAL'\n    };\n\n    // ABOVE_OR_BELOW only exists for baseline conditions.\n    if (!baseline && t.operator === 'ABOVE_OR_BELOW') {\n      term.operator = 'ABOVE';\n    } else {\n      term.operator = t.operator || 'ABOVE';\n    }\n\n    if (!Number.isFinite(term.threshold)) {\n      throw new Error(`Term has a non-numeric threshold (${t.threshold}) and cannot be migrated.`);\n    }\n\n    return term;\n  });\n\n  if (cleaned.length === 0) {\n    throw new Error('Condition has no thresholds/terms to migrate.');\n  }\n\n  return cleaned;\n}\n\nconst STATIC_CONDITION_MUTATION = `\n  mutation CreateStaticCondition($accountId: Int!, $policyId: ID!, $condition: AlertsNrqlConditionStaticInput!) {\n    alertsNrqlConditionStaticCreate(accountId: $accountId, policyId: $policyId, condition: $condition) {\n      id\n      name\n    }\n  }\n`;\n\nconst BASELINE_CONDITION_MUTATION = `\n  mutation CreateBaselineCondition($accountId: Int!, $policyId: ID!, $condition: AlertsNrqlConditionBaselineInput!) {\n    alertsNrqlConditionBaselineCreate(accountId: $accountId, policyId: $policyId, condition: $condition) {\n      id\n      name\n    }\n  }\n`;\n\n/**\n * IDEMPOTENT: Creates a NRQL condition under a target policy, routing static and\n * baseline conditions to their own mutations.\n *\n * `existingNames` is an optional pre-fetched Set of lowercased condition names; pass it\n * to avoid re-querying the target policy for every single condition.\n */\nexport async function createTargetNrqlCondition(accountId, policyId, condition, existingNames = null) {\n  const names = existingNames || (await fetchExistingConditionNames(accountId, policyId));\n  const wanted = (condition.name || '').trim().toLowerCase();\n\n  if (names.has(wanted)) {\n    return { id: null, name: condition.name, skipped: true };\n  }\n\n  if (!condition?.nrql?.query) {\n    throw new Error(`Condition \"${condition.name}\" has no NRQL query and cannot be migrated.`);\n  }\n\n  const typeName = condition.__typename || 'AlertsNrqlStaticCondition';\n\n  const shared = {\n    name: condition.name,\n    enabled: condition.enabled !== false,\n    description: condition.description || '',\n    nrql: { query: condition.nrql.query },\n    signal: buildSignalInput(condition.signal),\n    expiration: buildExpirationInput(condition.expiration),\n    violationTimeLimitSeconds: parseInt(condition.violationTimeLimitSeconds, 10) || 259200\n  };\n\n  if (condition.runbookUrl) {\n    shared.runbookUrl = condition.runbookUrl;\n  }\n\n  // Strip undefined so the mutation body stays free of nulls the schema may reject.\n  Object.keys(shared).forEach(k => shared[k] === undefined && delete shared[k]);\n\n  let mutation;\n  let payloadKey;\n  let conditionInput;\n\n  if (typeName === 'AlertsNrqlBaselineCondition') {\n    mutation = BASELINE_CONDITION_MUTATION;\n    payloadKey = 'alertsNrqlConditionBaselineCreate';\n    conditionInput = {\n      ...shared,\n      baselineDirection: condition.baselineDirection || 'UPPER_ONLY',\n      terms: buildTermsInput(condition.terms, { baseline: true })\n    };\n  } else if (typeName === 'AlertsNrqlStaticCondition') {\n    mutation = STATIC_CONDITION_MUTATION;\n    payloadKey = 'alertsNrqlConditionStaticCreate';\n    conditionInput = {\n      ...shared,\n      terms: buildTermsInput(condition.terms)\n    };\n  } else {\n    // Outlier and any future condition kinds have no create mutation we can map to.\n    throw new Error(\n      `Condition \"${condition.name}\" is of type ${typeName}, which this tool cannot recreate. Copy it manually.`\n    );\n  }\n\n  const data = await runMutation(mutation, {\n    accountId: parseInt(accountId),\n    policyId: String(policyId),\n    condition: conditionInput\n  });\n\n  const created = data?.[payloadKey];\n  if (!created?.id) {\n    throw new Error(`Condition \"${condition.name}\" was not created (no condition returned).`);\n  }\n\n  names.add(wanted);\n  return created;\n}\n\n/*************************************************************\n * NOTIFICATION DESTINATIONS & CHANNELS\n *************************************************************/\n\n/**\n * Queries all Notifications Destinations and Channels (all pages).\n */\nexport async function fetchDestinationsAndChannels(accountId) {\n  const accountIdInt = parseInt(accountId);\n\n  const destQuery = `\n    query GetDestinations($accountId: Int!, $cursor: String) {\n      actor {\n        account(id: $accountId) {\n          aiNotifications {\n            destinations(cursor: $cursor) {\n              nextCursor\n              entities {\n                id\n                name\n                type\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  const chanQuery = `\n    query GetChannels($accountId: Int!, $cursor: String) {\n      actor {\n        account(id: $accountId) {\n          aiNotifications {\n            channels(cursor: $cursor) {\n              nextCursor\n              entities {\n                id\n                name\n                type\n                destinationId\n                product\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  const destinations = await collectAllPages(async (cursor) => {\n    const data = await runGraphQL(destQuery, { accountId: accountIdInt, cursor }, { tolerateFieldErrors: true });\n    const page = data?.actor?.account?.aiNotifications?.destinations;\n    return { items: page?.entities || [], nextCursor: page?.nextCursor };\n  });\n\n  const channels = await collectAllPages(async (cursor) => {\n    const data = await runGraphQL(chanQuery, { accountId: accountIdInt, cursor }, { tolerateFieldErrors: true });\n    const page = data?.actor?.account?.aiNotifications?.channels;\n    return { items: page?.entities || [], nextCursor: page?.nextCursor };\n  });\n\n  return { destinations, channels };\n}\n\nexport async function fetchSingleDestinationDetails(accountId, destinationId) {\n  const query = `\n    query GetDestDetail($accountId: Int!, $id: ID!) {\n      actor {\n        account(id: $accountId) {\n          aiNotifications {\n            destinations(filters: { id: $id }) {\n              entities {\n                id\n                name\n                type\n                properties {\n                  key\n                  value\n                  label\n                  displayValue\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  const data = await runGraphQL(\n    query,\n    { accountId: parseInt(accountId), id: String(destinationId) },\n    { tolerateFieldErrors: true }\n  );\n  const dest = data?.actor?.account?.aiNotifications?.destinations?.entities?.[0];\n  if (!dest) {\n    throw new Error(`Destination ${destinationId} not found in the source account.`);\n  }\n  return dest;\n}\n\nexport async function fetchSingleChannelDetails(accountId, channelId) {\n  const query = `\n    query GetChanDetail($accountId: Int!, $id: ID!) {\n      actor {\n        account(id: $accountId) {\n          aiNotifications {\n            channels(filters: { id: $id }) {\n              entities {\n                id\n                name\n                type\n                destinationId\n                product\n                properties {\n                  key\n                  value\n                  label\n                  displayValue\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  const data = await runGraphQL(\n    query,\n    { accountId: parseInt(accountId), id: String(channelId) },\n    { tolerateFieldErrors: true }\n  );\n  const chan = data?.actor?.account?.aiNotifications?.channels?.entities?.[0];\n  if (!chan) {\n    throw new Error(`Channel ${channelId} not found in the source account.`);\n  }\n  return chan;\n}\n\n/**\n * The aiNotifications mutations report failures in a typed union rather than as\n * top-level GraphQL errors, so it has to be unwrapped explicitly.\n */\nconst AI_NOTIFICATIONS_ERROR_FRAGMENT = `\n  error {\n    __typename\n    ... on AiNotificationsResponseError {\n      description\n      details\n      type\n    }\n    ... on AiNotificationsDataValidationError {\n      details\n      fields {\n        field\n        message\n      }\n    }\n    ... on AiNotificationsConstraintsError {\n      constraints {\n        name\n        dependencies\n      }\n    }\n    ... on AiNotificationsSuggestionError {\n      description\n      details\n      type\n    }\n  }\n`;\n\nfunction describeAiNotificationsError(error) {\n  if (!error) return null;\n\n  if (Array.isArray(error.fields) && error.fields.length > 0) {\n    return error.fields.map(f => `${f.field}: ${f.message}`).join('; ');\n  }\n  if (Array.isArray(error.constraints) && error.constraints.length > 0) {\n    return `Missing required configuration: ${error.constraints.map(c => c.name).join(', ')}`;\n  }\n  return [error.description, error.details, error.type].filter(Boolean).join(' - ') || error.__typename || 'Unknown notification error';\n}\n\nfunction propertiesToInput(properties) {\n  return (properties || []).map(p => ({\n    key: p.key,\n    value: p.value == null ? '' : String(p.value),\n    ...(p.label ? { label: p.label } : {}),\n    ...(p.displayValue ? { displayValue: p.displayValue } : {})\n  }));\n}\n\n/**\n * IDEMPOTENT: creates a notification destination in the target account.\n *\n * Destination types that hold credentials (WEBHOOK, SLACK, PAGERDUTY_*, JIRA, ...) are\n * refused rather than created empty: NerdGraph never returns their auth block, so a\n * \"successful\" create would produce a destination that silently drops every notification.\n */\nexport async function createTargetDestination(accountId, name, type, properties) {\n  const accountIdInt = parseInt(accountId);\n\n  const existing = await collectAllPages(async (cursor) => {\n    const query = `\n      query FindDest($accountId: Int!, $cursor: String) {\n        actor {\n          account(id: $accountId) {\n            aiNotifications {\n              destinations(cursor: $cursor) {\n                nextCursor\n                entities {\n                  id\n                  name\n                  type\n                }\n              }\n            }\n          }\n        }\n      }\n    `;\n    const data = await runGraphQL(query, { accountId: accountIdInt, cursor }, { tolerateFieldErrors: true });\n    const page = data?.actor?.account?.aiNotifications?.destinations;\n    return { items: page?.entities || [], nextCursor: page?.nextCursor };\n  });\n\n  const wanted = (name || '').trim().toLowerCase();\n  const match = existing.find(d => (d.name || '').trim().toLowerCase() === wanted && d.type === type);\n  if (match) {\n    return { id: match.id, name: match.name, type: match.type, skipped: true };\n  }\n\n  if (!canRecreateDestinationType(type)) {\n    const err = new Error(\n      `Destination \"${name}\" (${type}) stores credentials that the NerdGraph API will not return. ` +\n      `Create it once by hand in account ${accountId} using the same name, then re-run this migration and it will be reused.`\n    );\n    err.manualSetupRequired = true;\n    throw err;\n  }\n\n  const mutation = `\n    mutation CreateDestination($accountId: Int!, $destination: AiNotificationsDestinationInput!) {\n      aiNotificationsCreateDestination(accountId: $accountId, destination: $destination) {\n        destination {\n          id\n          name\n          type\n        }\n        ${AI_NOTIFICATIONS_ERROR_FRAGMENT}\n      }\n    }\n  `;\n\n  const data = await runMutation(mutation, {\n    accountId: accountIdInt,\n    destination: {\n      name,\n      type,\n      properties: propertiesToInput(properties)\n    }\n  });\n\n  const payload = data?.aiNotificationsCreateDestination;\n  if (payload?.error) {\n    throw new Error(`Destination \"${name}\": ${describeAiNotificationsError(payload.error)}`);\n  }\n  if (!payload?.destination?.id) {\n    throw new Error(`Destination \"${name}\" was not created (no destination returned).`);\n  }\n\n  return payload.destination;\n}\n\n/**\n * IDEMPOTENT: creates a notification channel bound to a target destination.\n * Matched on name + destination, because channel names are only unique per destination.\n */\nexport async function createTargetChannel(accountId, name, type, destinationId, product, properties) {\n  const accountIdInt = parseInt(accountId);\n\n  const existing = await collectAllPages(async (cursor) => {\n    const query = `\n      query FindChan($accountId: Int!, $cursor: String) {\n        actor {\n          account(id: $accountId) {\n            aiNotifications {\n              channels(cursor: $cursor) {\n                nextCursor\n                entities {\n                  id\n                  name\n                  type\n                  destinationId\n                }\n              }\n            }\n          }\n        }\n      }\n    `;\n    const data = await runGraphQL(query, { accountId: accountIdInt, cursor }, { tolerateFieldErrors: true });\n    const page = data?.actor?.account?.aiNotifications?.channels;\n    return { items: page?.entities || [], nextCursor: page?.nextCursor };\n  });\n\n  const wanted = (name || '').trim().toLowerCase();\n  const match = existing.find(\n    c => (c.name || '').trim().toLowerCase() === wanted && String(c.destinationId) === String(destinationId)\n  );\n  if (match) {\n    return { id: match.id, name: match.name, skipped: true };\n  }\n\n  const mutation = `\n    mutation CreateChannel($accountId: Int!, $channel: AiNotificationsChannelInput!) {\n      aiNotificationsCreateChannel(accountId: $accountId, channel: $channel) {\n        channel {\n          id\n          name\n        }\n        ${AI_NOTIFICATIONS_ERROR_FRAGMENT}\n      }\n    }\n  `;\n\n  const data = await runMutation(mutation, {\n    accountId: accountIdInt,\n    channel: {\n      name,\n      type,\n      destinationId: String(destinationId),\n      product: product || 'IINT',\n      properties: propertiesToInput(properties)\n    }\n  });\n\n  const payload = data?.aiNotificationsCreateChannel;\n  if (payload?.error) {\n    throw new Error(`Channel \"${name}\": ${describeAiNotificationsError(payload.error)}`);\n  }\n  if (!payload?.channel?.id) {\n    throw new Error(`Channel \"${name}\" was not created (no channel returned).`);\n  }\n\n  return payload.channel;\n}\n\n/*************************************************************\n * WORKFLOWS\n *************************************************************/\n\n/**\n * Discovers workflows in an account (all pages).\n */\nexport async function discoverWorkflows(accountId) {\n  const query = `\n    query GetWorkflows($accountId: Int!, $cursor: String) {\n      actor {\n        account(id: $accountId) {\n          aiWorkflows {\n            workflows(cursor: $cursor) {\n              nextCursor\n              entities {\n                id\n                name\n                workflowEnabled\n                destinationsEnabled\n                mutingRulesHandling\n                issuesFilter {\n                  name\n                  type\n                  predicates {\n                    attribute\n                    operator\n                    values\n                  }\n                }\n                destinationConfigurations {\n                  channelId\n                  notificationTriggers\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  `;\n\n  return collectAllPages(async (cursor) => {\n    const data = await runGraphQL(query, { accountId: parseInt(accountId), cursor }, { tolerateFieldErrors: true });\n    const page = data?.actor?.account?.aiWorkflows?.workflows;\n    return { items: page?.entities || [], nextCursor: page?.nextCursor };\n  });\n}\n\n/**\n * IDEMPOTENT: Creates a target Workflow, skipping duplicates by name.\n *\n * `workflow` is the source workflow plus already-remapped predicates and destination\n * configurations. Enabled state, muting-rule handling and the issues-filter type are\n * carried over from the source instead of being hardcoded.\n */\nexport async function createTargetWorkflow(accountId, workflow) {\n  const { name, issuesFilter, destinationConfigurations } = workflow;\n\n  const existingWfs = await discoverWorkflows(accountId);\n  const wanted = (name || '').trim().toLowerCase();\n  const match = existingWfs.find(w => (w.name || '').trim().toLowerCase() === wanted);\n  if (match) {\n    return { id: match.id, name: match.name, skipped: true };\n  }\n\n  const configs = (destinationConfigurations || []).filter(dc => dc.channelId);\n  if (configs.length === 0) {\n    throw new Error(\n      `Workflow \"${name}\" has no notification channel that exists in the target account. ` +\n      `Migrate or manually create its destination first, then re-run.`\n    );\n  }\n\n  const mutation = `\n    mutation CreateWorkflow($accountId: Int!, $workflow: AiWorkflowsCreateWorkflowInput!) {\n      aiWorkflowsCreateWorkflow(accountId: $accountId, createWorkflowData: $workflow) {\n        workflow {\n          id\n          name\n        }\n        errors {\n          description\n          type\n        }\n      }\n    }\n  `;\n\n  const data = await runMutation(mutation, {\n    accountId: parseInt(accountId),\n    workflow: {\n      name,\n      workflowEnabled: workflow.workflowEnabled !== false,\n      destinationsEnabled: workflow.destinationsEnabled !== false,\n      mutingRulesHandling: workflow.mutingRulesHandling || 'NOTIFY_ALL_ISSUES',\n      issuesFilter: {\n        name: issuesFilter?.name || `${name} filter`,\n        type: issuesFilter?.type || 'FILTER',\n        predicates: (issuesFilter?.predicates || []).map(p => ({\n          attribute: p.attribute,\n          operator: p.operator,\n          values: (p.values || []).map(String)\n        }))\n      },\n      destinationConfigurations: configs.map(dc => ({\n        channelId: String(dc.channelId),\n        notificationTriggers: dc.notificationTriggers && dc.notificationTriggers.length > 0\n          ? dc.notificationTriggers\n          : ['ACTIVATED', 'CLOSED']\n      }))\n    }\n  });\n\n  const payload = data?.aiWorkflowsCreateWorkflow;\n  if (payload?.errors && payload.errors.length > 0) {\n    throw new Error(payload.errors.map(e => e.description || e.type).join('; '));\n  }\n  if (!payload?.workflow?.id) {\n    throw new Error(`Workflow \"${name}\" was not created (no workflow returned).`);\n  }\n\n  return payload.workflow;\n}\n","// path: nerdlets/nr1-migration-assistant/index.js\n\nimport React, { useState } from 'react';\nimport { TextField, Button, Spinner } from 'nr1';\nimport {\n  discoverDashboards, fetchSourceDashboard, createTargetDashboard, mapPageToDashboardPageInput, mapEntityToDashboardInput, mapVariables, verifyAccountAccess,\n  discoverAlertPolicies, fetchSingleConditionDetails, fetchPolicyConditionsList, createTargetAlertPolicy, createTargetNrqlCondition, fetchExistingConditionNames,\n  fetchDestinationsAndChannels, fetchSingleDestinationDetails, fetchSingleChannelDetails, createTargetDestination, createTargetChannel, canRecreateDestinationType,\n  discoverWorkflows, createTargetWorkflow\n} from './utils';\n\n/** Renders one status row in a migration log. */\nfunction StatusRow({ item }) {\n  const icons = { SUCCESS: '✅', SKIPPED: '↩️', MANUAL: '⚠️', FAILED: '❌', MIGRATING: '⏳', PENDING: '⏳' };\n  const badgeClass = { SUCCESS: 'success', SKIPPED: 'success', MANUAL: 'warning', FAILED: 'failed' };\n\n  return (\n    <div className={`summary-row ${item.status.toLowerCase()}`}>\n      <div className=\"summary-meta\">\n        {icons[item.status] || '⏳'}\n        <strong style={{ marginLeft: '8px' }}>{item.stepName}</strong>\n      </div>\n      <span className={`badge ${badgeClass[item.status] || 'neutral'}`}>\n        {item.status === 'SUCCESS' && (item.detail || 'Migrated')}\n        {item.status === 'SKIPPED' && (item.detail || 'Already existed - reused')}\n        {item.status === 'MANUAL' && `Needs manual setup: ${item.error}`}\n        {item.status === 'FAILED' && `Failed: ${item.error}`}\n        {(item.status === 'PENDING' || item.status === 'MIGRATING') && 'In queue'}\n      </span>\n    </div>\n  );\n}\n\nexport default function RelicShiftNerdlet() {\n  const [module, setModule] = useState(null); // null = Home, 'DASHBOARD' = Dashboards, 'ALERTS' = Alerts\n  const [step, setStep] = useState(0); \n  // For Alerts: \n  // step 0 = Account Credentials Config\n  // step 1 = Stage 1 Selection (Destinations & Workflows) [24, 25]\n  // step 2 = Stage 2 Selection (Policies & Conditions) [16]\n  // step 3 = Loading Orchestrator\n  // step 4 = Final Batch Summary\n  const [alertsTab, setAlertsTab] = useState('DESTINATIONS'); // 'DESTINATIONS', 'WORKFLOWS' in Stage 1\n\n  // Account IDs\n  const [sourceAccountId, setSourceAccountId] = useState('');\n  const [targetAccountId, setTargetAccountId] = useState('');\n\n  // Search Filter Variables (Only used in Dashboards now)\n  const [filterType, setFilterType] = useState('ALL'); \n  const [keyword, setKeyword] = useState('');\n  const [tagKey, setTagKey] = useState('');\n  const [tagValue, setTagValue] = useState('');\n  const [errorMsg, setErrorMsg] = useState('');\n\n  // Module A: Dashboard States\n  const [discoveredDashboards, setDiscoveredDashboards] = useState([]);\n  const [selectedGuids, setSelectedGuids] = useState({});\n  const [migrationProgress, setMigrationProgress] = useState([]);\n\n  // Module B: Step-by-Step Alerts States\n  const [discoveredDestinations, setDiscoveredDestinations] = useState([]);\n  const [selectedDestinationIds, setSelectedDestinationIds] = useState({});\n  const [discoveredWorkflows, setDiscoveredWorkflows] = useState([]);\n  const [selectedWorkflowIds, setSelectedWorkflowIds] = useState({});\n  const [discoveredPolicies, setDiscoveredPolicies] = useState([]);\n  const [selectedPolicyIds, setSelectedPolicyIds] = useState({});\n  const [selectedConditionIds, setSelectedConditionIds] = useState({});\n  const [alertProgress, setAlertProgress] = useState([]);\n  // Stage 1 (destinations + channels) results, so notification failures are visible\n  // instead of being swallowed into a console warning.\n  const [notifyProgress, setNotifyProgress] = useState([]);\n\n  // ID Maps preserved during migration stages\n  const [mappedDestinations, setMappedDestinations] = useState({});\n  const [mappedChannels, setMappedChannels] = useState({});\n  const [mappedPolicies, setMappedPolicies] = useState({});\n\n  const handleFilterTypeChange = (type) => {\n    setFilterType(type);\n    setKeyword('');\n    setTagKey('');\n    setTagValue('');\n  };\n\n  const handleResetToHome = () => {\n    setModule(null);\n    setStep(0);\n    setAlertsTab('DESTINATIONS');\n    setErrorMsg('');\n    setKeyword('');\n    setTagKey('');\n    setTagValue('');\n    setFilterType('ALL');\n    setDiscoveredDashboards([]);\n    setDiscoveredPolicies([]);\n    setDiscoveredDestinations([]);\n    setDiscoveredWorkflows([]);\n    setSelectedGuids({});\n    setSelectedPolicyIds({});\n    setSelectedConditionIds({});\n    setSelectedDestinationIds({});\n    setSelectedWorkflowIds({});\n    setMigrationProgress([]);\n    setAlertProgress([]);\n    setNotifyProgress([]);\n    setMappedDestinations({});\n    setMappedChannels({});\n    setMappedPolicies({});\n  };\n\n  const handleBackToConfig = () => {\n    setStep(0);\n    setAlertsTab('DESTINATIONS');\n    setErrorMsg('');\n    setDiscoveredDashboards([]);\n    setDiscoveredPolicies([]);\n    setDiscoveredDestinations([]);\n    setDiscoveredWorkflows([]);\n    setSelectedGuids({});\n    setSelectedPolicyIds({});\n    setSelectedConditionIds({});\n    setSelectedDestinationIds({});\n    setSelectedWorkflowIds({});\n    setAlertProgress([]);\n    setNotifyProgress([]);\n    setMappedDestinations({});\n    setMappedChannels({});\n    setMappedPolicies({});\n  };\n\n  /*************************************************************\n   * DASHBOARD MIGRATION RUNNER\n   *************************************************************/\n  const handleSearchDashboards = async () => {\n    if (!sourceAccountId || !targetAccountId) {\n      alert('Both Source and Target Account IDs are required.');\n      return;\n    }\n    if (filterType === 'TAG' && (!tagKey.trim() || !tagValue.trim())) {\n      alert('Validation Error: Both Tag Key and Tag Value are required.');\n      return;\n    }\n    if (filterType === 'KEYWORD' && !keyword.trim()) {\n      alert('Validation Error: A Keyword is required.');\n      return;\n    }\n\n    setStep(2);\n    setErrorMsg('');\n    try {\n      await verifyAccountAccess(sourceAccountId, targetAccountId);\n      const list = await discoverDashboards(sourceAccountId, { type: filterType, keyword, tagKey, tagValue });\n      if (list.length === 0) {\n        throw new Error(\"No dashboards found matching the selected criteria.\");\n      }\n      setDiscoveredDashboards(list);\n      const selectionMap = {};\n      list.forEach(item => { selectionMap[item.guid] = true; });\n      setSelectedGuids(selectionMap);\n      setStep(1);\n    } catch (err) {\n      setErrorMsg(err.message);\n      setStep(0);\n    }\n  };\n\n  const handleMigrateDashboards = async () => {\n    const selectedList = discoveredDashboards.filter(d => selectedGuids[d.guid]);\n    if (selectedList.length === 0) {\n      alert('Select at least one dashboard to migrate.');\n      return;\n    }\n    setStep(2);\n    setErrorMsg('');\n    const progressList = selectedList.map(item => ({ name: item.name, status: 'PENDING', error: '' }));\n    setMigrationProgress(progressList);\n\n    for (let i = 0; i < selectedList.length; i++) {\n      const parentDashboard = selectedList[i];\n      setMigrationProgress(prev => {\n        const copy = [...prev];\n        copy[i].status = 'MIGRATING';\n        return copy;\n      });\n\n      try {\n        const details = await fetchSourceDashboard(parentDashboard.guid);\n        let dashboardInput = null;\n\n        if (details.pages && details.pages.length > 1) {\n          dashboardInput = mapEntityToDashboardInput(details, sourceAccountId, targetAccountId);\n        } else if (parentDashboard.pagesToMigrate && parentDashboard.pagesToMigrate.length > 1) {\n          const combinedPages = [];\n          const addedPageNames = new Set();\n          for (const subPage of parentDashboard.pagesToMigrate) {\n            const pageDetails = await fetchSourceDashboard(subPage.guid);\n            if (pageDetails?.pages?.length > 0) {\n              for (const innerPage of pageDetails.pages) {\n                let cleanName = innerPage.name;\n                if (cleanName.includes(' / ')) {\n                  cleanName = cleanName.split(' / ').slice(1).join(' / ').trim();\n                }\n                if (cleanName === parentDashboard.name || cleanName.toLowerCase() === 'overview') {\n                  cleanName = 'Overview';\n                }\n                if (!addedPageNames.has(cleanName.toLowerCase())) {\n                  addedPageNames.add(cleanName.toLowerCase());\n                  const mappedPage = mapPageToDashboardPageInput(innerPage, sourceAccountId, targetAccountId);\n                  if (mappedPage) {\n                    mappedPage.name = cleanName;\n                    combinedPages.push(mappedPage);\n                  }\n                }\n              }\n            }\n          }\n          dashboardInput = {\n            name: parentDashboard.name,\n            permissions: \"PUBLIC_READ_WRITE\",\n            pages: combinedPages,\n            variables: mapVariables(details.variables || [], sourceAccountId, targetAccountId)\n          };\n        } else {\n          dashboardInput = mapEntityToDashboardInput(details, sourceAccountId, targetAccountId);\n        }\n\n        const result = await createTargetDashboard(targetAccountId, dashboardInput);\n        setMigrationProgress(prev => {\n          const copy = [...prev];\n          copy[i].status = 'SUCCESS';\n          copy[i].targetGuid = result.guid;\n          return copy;\n        });\n      } catch (err) {\n        setMigrationProgress(prev => {\n          const copy = [...prev];\n          copy[i].status = 'FAILED';\n          copy[i].error = err.message;\n          return copy;\n        });\n      }\n    }\n    setStep(3);\n  };\n\n  const handleDashboardCheckboxChange = (guid) => {\n    setSelectedGuids(prev => ({ ...prev, [guid]: !prev[guid] }));\n  };\n\n  const handleToggleSelectAllDashboards = (selectAll) => {\n    const updated = {};\n    discoveredDashboards.forEach(item => { updated[item.guid] = selectAll; });\n    setSelectedGuids(updated);\n  };\n\n  /*************************************************************\n   * STEP-BY-STEP ALERTS & WORKFLOWS ORCHESTRATOR (PHASE 2)\n   *************************************************************/\n  \n  // ALERTS STEP 0: Fetch Destinations & Workflows\n  const handleFetchAlertsStage1 = async () => {\n    if (!sourceAccountId || !targetAccountId) {\n      alert('Both Source and Target Account IDs are required.');\n      return;\n    }\n    setStep(3); // Go to loading orchestrator\n    setErrorMsg('');\n    try {\n      await verifyAccountAccess(sourceAccountId, targetAccountId);\n      \n      const notifyData = await fetchDestinationsAndChannels(sourceAccountId);\n      setDiscoveredDestinations(notifyData.destinations || []);\n      const initDestSelection = {};\n      notifyData.destinations.forEach(d => { initDestSelection[d.id] = true; });\n      setSelectedDestinationIds(initDestSelection);\n\n      // Fetch Workflows\n      const wfs = await discoverWorkflows(sourceAccountId);\n      setDiscoveredWorkflows(wfs);\n      const initWfSelection = {};\n      wfs.forEach(w => { initWfSelection[w.id] = true; });\n      setSelectedWorkflowIds(initWfSelection);\n\n      setStep(1); // Go to Stage 1 Selection list\n    } catch (err) {\n      setErrorMsg(err.message);\n      setStep(0);\n    }\n  };\n\n  // ALERTS STEP 1: Migrate Destinations/Channels & Fetch Policies\n  const handleMigrateAlertsStage1 = async () => {\n    const selectedWfs = discoveredWorkflows.filter(w => selectedWorkflowIds[w.id]);\n\n    setStep(3); // Loading screen\n    setErrorMsg('');\n    setNotifyProgress([]);\n\n    const log = [];\n    const pushLog = (entry) => {\n      log.push(entry);\n      setNotifyProgress([...log]);\n    };\n\n    try {\n      const targetDestMap = {};\n      const targetChannelMap = {};\n      const { channels } = await fetchDestinationsAndChannels(sourceAccountId);\n\n      // A workflow can only be recreated if the channels it routes to exist in the\n      // target. Pull in the destinations behind those channels even when the user did\n      // not tick them, otherwise Stage 2 fails with \"no channel in target account\".\n      const channelIdsNeededByWorkflows = new Set();\n      selectedWfs.forEach(w => {\n        (w.destinationConfigurations || []).forEach(dc => {\n          if (dc.channelId) channelIdsNeededByWorkflows.add(String(dc.channelId));\n        });\n      });\n\n      const neededDestIds = new Set(\n        discoveredDestinations.filter(d => selectedDestinationIds[d.id]).map(d => String(d.id))\n      );\n      const channelsNeeded = channels.filter(\n        c => selectedDestinationIds[c.destinationId] || channelIdsNeededByWorkflows.has(String(c.id))\n      );\n      channelsNeeded.forEach(c => c.destinationId && neededDestIds.add(String(c.destinationId)));\n\n      const destsToProcess = discoveredDestinations.filter(d => neededDestIds.has(String(d.id)));\n\n      // 1. Destinations\n      for (const dest of destsToProcess) {\n        const label = `Destination: ${dest.name} (${dest.type})`;\n        try {\n          const destDetails = await fetchSingleDestinationDetails(sourceAccountId, dest.id);\n          const targetDest = await createTargetDestination(\n            targetAccountId,\n            destDetails.name,\n            destDetails.type,\n            destDetails.properties\n          );\n          targetDestMap[dest.id] = targetDest.id;\n          pushLog({\n            stepName: label,\n            status: targetDest.skipped ? 'SKIPPED' : 'SUCCESS',\n            detail: targetDest.skipped ? 'Matched existing destination in target' : 'Created in target',\n            error: ''\n          });\n        } catch (e) {\n          // A destination holding unreadable credentials is an expected outcome, not a\n          // crash — surface it as an actionable warning and keep going.\n          pushLog({\n            stepName: label,\n            status: e.manualSetupRequired ? 'MANUAL' : 'FAILED',\n            error: e.message,\n            detail: ''\n          });\n        }\n      }\n\n      // 2. Channels\n      for (const chan of channelsNeeded) {\n        const label = `Channel: ${chan.name}`;\n        const targetDestId = targetDestMap[chan.destinationId];\n\n        if (!targetDestId) {\n          pushLog({\n            stepName: label,\n            status: 'MANUAL',\n            error: `Its destination is not available in account ${targetAccountId} yet.`,\n            detail: ''\n          });\n          continue;\n        }\n\n        try {\n          const chanDetails = await fetchSingleChannelDetails(sourceAccountId, chan.id);\n          const targetChannel = await createTargetChannel(\n            targetAccountId,\n            chanDetails.name,\n            chanDetails.type,\n            targetDestId,\n            chanDetails.product,\n            chanDetails.properties\n          );\n          targetChannelMap[chan.id] = targetChannel.id;\n          pushLog({\n            stepName: label,\n            status: targetChannel.skipped ? 'SKIPPED' : 'SUCCESS',\n            detail: targetChannel.skipped ? 'Matched existing channel in target' : 'Created in target',\n            error: ''\n          });\n        } catch (e) {\n          pushLog({ stepName: label, status: 'FAILED', error: e.message, detail: '' });\n        }\n      }\n\n      setMappedDestinations(targetDestMap);\n      setMappedChannels(targetChannelMap);\n\n      // 3. Fetch policies & conditions for the Stage 2 checklist.\n      const policies = await discoverAlertPolicies(sourceAccountId, { type: 'ALL' });\n      const activePolicies = [];\n      const initPolicySelection = {};\n      const initCondSelection = {};\n\n      for (const p of policies) {\n        let conds = [];\n        try {\n          conds = await fetchPolicyConditionsList(sourceAccountId, p.id);\n        } catch (e) {\n          console.warn(`Could not list conditions for policy ${p.name}: ${e.message}`);\n        }\n        activePolicies.push({ ...p, conditions: conds });\n        initPolicySelection[p.id] = true;\n        conds.forEach(c => { initCondSelection[c.id] = true; });\n      }\n\n      setDiscoveredPolicies(activePolicies);\n      setSelectedPolicyIds(initPolicySelection);\n      setSelectedConditionIds(initCondSelection);\n\n      setStep(2); // Move user cleanly to Stage 2 Selection Checklist\n    } catch (e) {\n      setErrorMsg(e.message);\n      setStep(1);\n    }\n  };\n\n  // ALERTS STEP 2: Migrate Policies, Conditions, and link Workflows\n  const handleMigrateAlertsStage2 = async () => {\n    const selectedPolicies = discoveredPolicies.filter(p => selectedPolicyIds[p.id]);\n    const selectedWfs = discoveredWorkflows.filter(w => selectedWorkflowIds[w.id]);\n\n    setStep(3); // Loading screen\n    setErrorMsg('');\n\n    // Pre-initialize stepper logs: one row per policy, then one row per workflow.\n    const taskLogs = [\n      ...selectedPolicies.map(p => ({ stepName: `Policy: ${p.name}`, status: 'PENDING', error: '', detail: '' })),\n      ...selectedWfs.map(w => ({ stepName: `Workflow: ${w.name}`, status: 'PENDING', error: '', detail: '' }))\n    ];\n    setAlertProgress(taskLogs);\n\n    const updateLog = (idx, patch) => {\n      setAlertProgress(prev => prev.map((row, i) => (i === idx ? { ...row, ...patch } : row)));\n    };\n\n    const policyIdMap = {};\n\n    // 1. Migrate Policies & Conditions\n    for (let idx = 0; idx < selectedPolicies.length; idx++) {\n      const policy = selectedPolicies[idx];\n      updateLog(idx, { status: 'MIGRATING' });\n\n      try {\n        const targetPolicy = await createTargetAlertPolicy(targetAccountId, policy.name, policy.incidentPreference);\n        policyIdMap[policy.id] = targetPolicy.id;\n\n        const activeConds = (policy.conditions || []).filter(c => selectedConditionIds[c.id]);\n        // Read the target policy's existing condition names once, not once per condition.\n        const existingNames = await fetchExistingConditionNames(targetAccountId, targetPolicy.id);\n\n        let created = 0;\n        let reused = 0;\n        const condFailures = [];\n\n        for (const cond of activeConds) {\n          try {\n            const conditionDetails = await fetchSingleConditionDetails(sourceAccountId, cond.id);\n            const result = await createTargetNrqlCondition(\n              targetAccountId,\n              targetPolicy.id,\n              conditionDetails,\n              existingNames\n            );\n            if (result.skipped) reused += 1;\n            else created += 1;\n          } catch (e) {\n            // One bad condition must not abandon the rest of the policy.\n            condFailures.push(`${cond.name}: ${e.message}`);\n          }\n        }\n\n        const summary = [\n          `${created} condition(s) created`,\n          reused > 0 ? `${reused} reused` : null,\n          targetPolicy.skipped ? 'policy reused' : 'policy created'\n        ].filter(Boolean).join(', ');\n\n        if (condFailures.length > 0) {\n          updateLog(idx, {\n            status: 'FAILED',\n            error: `${summary}. ${condFailures.length} condition(s) failed - ${condFailures.join(' | ')}`\n          });\n        } else {\n          updateLog(idx, { status: targetPolicy.skipped && created === 0 ? 'SKIPPED' : 'SUCCESS', detail: summary });\n        }\n      } catch (e) {\n        updateLog(idx, { status: 'FAILED', error: e.message });\n      }\n    }\n\n    // 2. Migrate Workflows, rebinding them to the target policies and channels.\n    for (let w = 0; w < selectedWfs.length; w++) {\n      const wf = selectedWfs[w];\n      const idx = selectedPolicies.length + w;\n      updateLog(idx, { status: 'MIGRATING' });\n\n      try {\n        const sourceFilter = wf.issuesFilter || {};\n\n        const unmappedPolicies = [];\n        const updatedPredicates = (sourceFilter.predicates || []).map(p => {\n          if (p.attribute === 'labels.policyIds') {\n            const cleanValues = (p.values || []).map(val => {\n              const mapped = policyIdMap[val];\n              if (!mapped) unmappedPolicies.push(val);\n              return mapped || val;\n            });\n            return { ...p, values: cleanValues };\n          }\n          return p;\n        });\n\n        if (unmappedPolicies.length > 0) {\n          // Keeping a source policy ID here would silently produce a workflow that\n          // never matches an issue in the target account.\n          throw new Error(\n            `It filters on source policy ID(s) ${unmappedPolicies.join(', ')} that were not migrated in this run. ` +\n            `Select those policies in Stage 2 and re-run.`\n          );\n        }\n\n        const updatedDestinationConfigs = (wf.destinationConfigurations || [])\n          .map(dc => ({\n            channelId: mappedChannels[dc.channelId],\n            notificationTriggers: dc.notificationTriggers\n          }))\n          .filter(dc => dc.channelId);\n\n        const result = await createTargetWorkflow(targetAccountId, {\n          name: wf.name,\n          workflowEnabled: wf.workflowEnabled,\n          destinationsEnabled: wf.destinationsEnabled,\n          mutingRulesHandling: wf.mutingRulesHandling,\n          issuesFilter: {\n            name: sourceFilter.name,\n            type: sourceFilter.type,\n            predicates: updatedPredicates\n          },\n          destinationConfigurations: updatedDestinationConfigs\n        });\n\n        updateLog(idx, {\n          status: result.skipped ? 'SKIPPED' : 'SUCCESS',\n          detail: result.skipped ? 'Matched existing workflow in target' : 'Created in target'\n        });\n      } catch (e) {\n        updateLog(idx, { status: 'FAILED', error: e.message });\n      }\n    }\n\n    setStep(4); // Always land on the summary so partial results stay visible.\n  };\n\n  const handlePolicyCheckboxChange = (policy) => {\n    const targetState = !selectedPolicyIds[policy.id];\n    setSelectedPolicyIds(prev => ({ ...prev, [policy.id]: targetState }));\n    const updatedConds = { ...selectedConditionIds };\n    (policy.conditions || []).forEach(c => {\n      updatedConds[c.id] = targetState;\n    });\n    setSelectedConditionIds(updatedConds);\n  };\n\n  const handleConditionCheckboxChange = (condition, policyId) => {\n    const targetState = !selectedConditionIds[condition.id];\n    setSelectedConditionIds(prev => ({ ...prev, [condition.id]: targetState }));\n    if (targetState) {\n      setSelectedPolicyIds(prev => ({ ...prev, [policyId]: true }));\n    }\n  };\n\n  const handleDestinationCheckboxChange = (id) => {\n    setSelectedDestinationIds(prev => ({ ...prev, [id]: !prev[id] }));\n  };\n\n  const handleWorkflowCheckboxChange = (id) => {\n    setSelectedWorkflowIds(prev => ({ ...prev, [id]: !prev[id] }));\n  };\n\n  const handleToggleSelectAllPolicies = (selectAll) => {\n    const updatedP = {};\n    const updatedC = {};\n    discoveredPolicies.forEach(p => {\n      updatedP[p.id] = selectAll;\n      (p.conditions || []).forEach(c => {\n        updatedC[c.id] = selectAll;\n      });\n    });\n    setSelectedPolicyIds(updatedP);\n    setSelectedConditionIds(updatedC);\n  };\n\n  const handleToggleSelectAllDestinations = (selectAll) => {\n    const updated = {};\n    discoveredDestinations.forEach(d => { updated[d.id] = selectAll; });\n    setSelectedDestinationIds(updated);\n  };\n\n  const handleToggleSelectAllWorkflows = (selectAll) => {\n    const updated = {};\n    discoveredWorkflows.forEach(w => { updated[w.id] = selectAll; });\n    setSelectedWorkflowIds(updated);\n  };\n\n  return (\n    <div className=\"relic-shift-container\">\n      {/* App Header */}\n      <div className=\"header-banner\">\n        <h1 className=\"main-title\">🔄 New Relic Migration Assistant</h1>\n        <p className=\"sub-title\">Safely migrate New Relic configurations across accounts context.</p>\n      </div>\n\n      {/* Choice Homepage */}\n      {module === null && (\n        <div className=\"home-wrapper\">\n          <h2 className=\"home-title\" style={{ fontSize: '22px', fontWeight: 'bold', color: '#1d252c', marginBottom: '32px' }}>\n            Select Migration Module\n          </h2>\n          <div className=\"home-card-grid\">\n            <div className=\"module-choice-card\" onClick={() => setModule('DASHBOARD')}>\n              <div className=\"choice-icon\">📊</div>\n              <h3>Dashboards Module</h3>\n              <p>Batch migrate modern multi-page and legacy tabbed dashboards. Clean, deduplicated pages with automatic cross-account query re-routing.</p>\n              <button className=\"choice-btn\">Configure Dashboards</button>\n            </div>\n            \n            <div className=\"module-choice-card\" onClick={() => setModule('ALERTS')}>\n              <div className=\"choice-icon\">🚨</div>\n              <h3>Alerts & Incident Systems</h3>\n              <p>Migrate notification destinations, channels, alert policies, NRQL conditions, and workflows sequentially. Automatically translates underlying policy dependencies.</p>\n              <button className=\"choice-btn\">Configure Alerts</button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* DASHBOARDS MODULE (UNTOUCHED & PRESERVED) */}\n      {module === 'DASHBOARD' && (\n        <div className=\"layout-body-wrapper\">\n          <div className=\"module-nav-bar\">\n            <button className=\"pure-btn plain-btn small-btn\" onClick={handleResetToHome}>🏠 Back to Home</button>\n            <span className=\"nav-module-label\">Active Module: <strong>Dashboards</strong></span>\n          </div>\n\n          {errorMsg && (\n            <div className=\"error-card\">\n              <h4>⚠️ Discovery Error</h4>\n              <p>{errorMsg}</p>\n            </div>\n          )}\n\n          {step === 0 && (\n            <div className=\"main-card\">\n              <h3>1. Migration Setup & Discovery Controls</h3>\n              <p className=\"card-desc\">Specify source and target New Relic Account IDs to discover and migrate configurations.</p>\n              \n              <div className=\"inner-form-custom-grid\">\n                <div className=\"grid-column\">\n                  <h4>Source Configuration</h4>\n                  <div className=\"input-wrapper\">\n                    <label>Source Account ID</label>\n                    <input type=\"text\" className=\"pure-input\" placeholder=\"e.g. 1234567\" value={sourceAccountId} onChange={(e) => setSourceAccountId(e.target.value)} />\n                  </div>\n                </div>\n                <div className=\"grid-column\">\n                  <h4>Target Configuration</h4>\n                  <div className=\"input-wrapper\">\n                    <label>Target Account ID</label>\n                    <input type=\"text\" className=\"pure-input\" placeholder=\"e.g. 9876543\" value={targetAccountId} onChange={(e) => setTargetAccountId(e.target.value)} />\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"filter-strategy-section\">\n                <h4>Discovery Strategy</h4>\n                <div className=\"radio-group-container\">\n                  <label className=\"radio-label\">\n                    <input type=\"radio\" name=\"filterType\" value=\"ALL\" checked={filterType === 'ALL'} onChange={() => handleFilterTypeChange('ALL')} />\n                    Migrate All Dashboards\n                  </label>\n                  <label className=\"radio-label\">\n                    <input type=\"radio\" name=\"filterType\" value=\"KEYWORD\" checked={filterType === 'KEYWORD'} onChange={() => handleFilterTypeChange('KEYWORD')} />\n                    Filter by Keyword\n                  </label>\n                  <label className=\"radio-label\">\n                    <input type=\"radio\" name=\"filterType\" value=\"TAG\" checked={filterType === 'TAG'} onChange={() => handleFilterTypeChange('TAG')} />\n                    Filter by Tag Key/Value\n                  </label>\n                </div>\n\n                {filterType === 'KEYWORD' && (\n                  <div className=\"conditional-input-box\">\n                    <div className=\"input-wrapper\">\n                      <label>Keyword</label>\n                      <input type=\"text\" className=\"pure-input\" placeholder=\"e.g. Production, Billings, Web\" value={keyword} onChange={(e) => setKeyword(e.target.value)} />\n                    </div>\n                  </div>\n                )}\n\n                {filterType === 'TAG' && (\n                  <div className=\"conditional-input-box tag-grid\">\n                    <div className=\"input-wrapper\">\n                      <label>Tag Key</label>\n                      <input type=\"text\" className=\"pure-input\" placeholder=\"e.g. env\" value={tagKey} onChange={(e) => setTagKey(e.target.value)} />\n                    </div>\n                    <div className=\"input-wrapper\">\n                      <label>Tag Value</label>\n                      <input type=\"text\" className=\"pure-input\" placeholder=\"e.g. production\" value={tagValue} onChange={(e) => setTagValue(e.target.value)} />\n                    </div>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"button-group\">\n                <button onClick={handleSearchDashboards} className=\"pure-btn primary-btn\">Search & Fetch Dashboards</button>\n              </div>\n            </div>\n          )}\n\n          {step === 1 && discoveredDashboards.length > 0 && (\n            <div className=\"main-card\">\n              <h3>2. Select Dashboards for Migration</h3>\n              <p className=\"card-desc\">The search discovered <strong>{discoveredDashboards.length}</strong> parent dashboards. Check the items you want to migrate.</p>\n              \n              <div className=\"selection-utilities\">\n                <button onClick={() => handleToggleSelectAllDashboards(true)} className=\"pure-btn plain-btn small-btn\">Select All</button>\n                <button onClick={() => handleToggleSelectAllDashboards(false)} className=\"pure-btn plain-btn small-btn\">Deselect All</button>\n              </div>\n\n              <div className=\"dashboard-checklist-box\">\n                {discoveredDashboards.map((db) => (\n                  <div key={db.guid} className=\"checkbox-item\" onClick={() => handleDashboardCheckboxChange(db.guid)}>\n                    <input type=\"checkbox\" checked={!!selectedGuids[db.guid]} readOnly />\n                    <span className=\"checklist-details\">\n                      <strong>{db.name}</strong